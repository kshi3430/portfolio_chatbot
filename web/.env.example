# Python RAG FastAPI server URL (Used by both local Express server and Vercel /api/chat proxy)
RAG_API_URL="http://127.0.0.1:8001"

# Optional fallback number for the Vercel visitor counter.
VISITOR_COUNT="717"

# LangSmith tracing (optional - set in Vercel/Render env vars)
LANGSMITH_TRACING="true"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="portfolio-chatbot"
