# Required in Vercel Project Settings > Environment Variables.
UPSTAGE_API_KEY="your-upstage-api-key-here"
UPSTAGE_MODEL="solar-pro4"
UPSTAGE_EMBEDDING_PASSAGE_MODEL="solar-embedding-2-passage"
UPSTAGE_EMBEDDING_QUERY_MODEL="solar-embedding-2-query"
UPSTAGE_BASE_URL="https://api.upstage.ai/v1"

# Optional fallback number for the Vercel visitor counter.
VISITOR_COUNT="717"

# Local Express dev server only. Vercel uses api/chat.ts directly.
RAG_API_URL="http://127.0.0.1:8001"
