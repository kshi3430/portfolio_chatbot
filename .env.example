# Upstage API Key
# https://console.upstage.ai/ 에서 발급받으세요.
UPSTAGE_API_KEY="your-upstage-api-key-here"

# Optional: 기본값은 solar-pro4입니다.
UPSTAGE_MODEL="solar-pro4"

# Optional: 문서(passage)와 질의(query) 임베딩 모델입니다.
UPSTAGE_EMBEDDING_PASSAGE_MODEL="solar-embedding-2-passage"
UPSTAGE_EMBEDDING_QUERY_MODEL="solar-embedding-2-query"
UPSTAGE_BASE_URL="https://api.upstage.ai/v1"
